      {
        "constant": "BASE_PATIENCE",
        "value": "2.5",
        "provenance": "assumption",
        "source": "Goodwill budget per customer in nudge-attention units. At SMS cost 0.40 this permits roughly six sends before exhaustion.",
        "note": ""
      },
      {
        "constant": "BASE_SUCCESS_RATE[UPI_INTENT]",
        "value": "0.93",
        "provenance": "published",
        "source": "Razorpay, 'Payment Success Rate Optimization India' (2026 guide)",
        "note": "UPI target band 90-95%; falls to 80-85% under load."
      },
      {
        "constant": "BASE_SUCCESS_RATE[UPI_COLLECT]",
        "value": "0.86",
        "provenance": "derived",
        "source": "Razorpay, 'Payment Success Rate Optimization India' (2026 guide)",
        "note": "UPI band minus collect-request abandonment: the payer must open an app they did not initiate from, so drop-off is structurally higher."
      },
      {
        "constant": "BASE_SUCCESS_RATE[CARD]",
        "value": "0.9",
        "provenance": "published",
        "source": "Razorpay, 'Payment Success Rate Optimization India' (2026 guide)",
        "note": "Domestic card target band 85-95%."
      },
      {
        "constant": "BASE_SUCCESS_RATE[NETBANKING]",
        "value": "0.85",
        "provenance": "assumption",
        "source": "Razorpay routes high-value away from netbanking toward UPI/card for success, implying netbanking sits below both. Set just under the card band floor.",
        "note": ""
      },
      {
        "constant": "BASE_SUCCESS_RATE[WALLET]",
        "value": "0.95",
        "provenance": "assumption",
        "source": "Closed-loop, pre-funded, no issuer in the path: the highest-success rail available. Set at the top of the observed range.",
        "note": ""
      },
      {
        "constant": "BD_SHARE_OF_FAILURES",
        "value": "0.817",
        "provenance": "published",
        "source": "Business Standard, 'Insufficient balance, wrong PIN top reasons for failed digital transactions' (Dec 2021)",
        "note": "Of all failed transactions, ~81.7% business decline / ~18.3% technical."
      },
      {
        "constant": "BUSINESS_DECLINE_RATE",
        "value": "0.076",
        "provenance": "published",
        "source": "Business Standard, 'Insufficient balance, wrong PIN top reasons for failed digital transactions' (Dec 2021)",
        "note": "Customer-caused declines: insufficient balance, wrong PIN, do-not-honour."
      },
      {
        "constant": "CHURN_HAZARD_AT_ZERO_PATIENCE",
        "value": "0.25",
        "provenance": "assumption",
        "source": "Probability a customer abandons the payment outright once their goodwill budget is spent. Over-nudging is modelled as genuinely destructive, not merely ineffective -- otherwise the optimal policy is to spam forever.",
